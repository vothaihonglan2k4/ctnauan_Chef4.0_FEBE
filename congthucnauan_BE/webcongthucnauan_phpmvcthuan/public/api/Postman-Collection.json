						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Tên Đã Cập Nhật\",\n    \"email\": \"email_moi@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/profile",
							"host": ["{{base_url}}"],
							"path": ["users", "profile"]
						}
					}
				},
