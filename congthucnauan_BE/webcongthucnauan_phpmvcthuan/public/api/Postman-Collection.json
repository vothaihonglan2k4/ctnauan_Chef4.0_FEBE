{
	"info": {
		"_postman_id": "cooking-recipe-api",
		"name": "Website Công Thức Nấu Ăn API",
		"description": "Complete API collection for cooking recipe website",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🍲 Recipes",
			"item": [
				{
					"name": "Get All Recipes",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/recipes",
							"host": ["{{base_url}}"],
							"path": ["recipes"]
						}
					}
				},
				{
					"name": "Get Recipe by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/recipes/2",
							"host": ["{{base_url}}"],
							"path": ["recipes", "2"]
						}
					}
				},
				{
					"name": "Search Recipes",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/recipes?search=phở",
							"host": ["{{base_url}}"],
							"path": ["recipes"],
							"query": [
								{
									"key": "search",
									"value": "phở"
								}
							]
						}
					}
				},
				{
					"name": "Filter by Category",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/recipes?category=1",
							"host": ["{{base_url}}"],
							"path": ["recipes"],
							"query": [
								{
									"key": "category",
									"value": "1"
								}
							]
						}
					}
				},
				{
					"name": "Create Recipe",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Phở Bò Hà Nội\",\n    \"description\": \"Món phở truyền thống của Hà Nội\",\n    \"ingredients\": \"Bánh phở, thịt bò, hành lá, ngò gai, nước dùng\",\n    \"instructions\": \"1. Nấu nước dùng trong 8 tiếng\\n2. Trụng bánh phở\\n3. Thái thịt bò mỏng\\n4. Bày món và thưởng thức\",\n    \"category_id\": 1,\n    \"image\": \"pho-bo.jpg\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/recipes",
							"host": ["{{base_url}}"],
							"path": ["recipes"]
						}
					}
				}
			]
		},
		{
			"name": "👤 Users",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Nguyễn Văn A\",\n    \"email\": \"test@example.com\",\n    \"password\": \"123456\",\n    \"confirm_password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/register",
							"host": ["{{base_url}}"],
							"path": ["users", "register"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/login",
							"host": ["{{base_url}}"],
							"path": ["users", "login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Auto set token từ response",
									"if (pm.response.code === 200) {",
									"    var response = pm.response.json();",
									"    if (response.status === 'success' && response.data.token) {",
									"        pm.environment.set('token', response.data.token);",
									"        console.log('Token set: ' + response.data.token);",
									"    }",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/profile",
							"host": ["{{base_url}}"],
							"path": ["users", "profile"]
						}
					}
				},
